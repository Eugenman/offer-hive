# Local development settings. Copy to .env and fill in; .env is never committed.

# Password of the local Postgres in docker-compose. Letters and digits only (it goes into a URL).
# Postgres keeps the password it was first started with; to change it later, remove the volume
# (docker compose down -v, which deletes the local data) or run ALTER USER in the container.
POSTGRES_PASSWORD=change-me

# Host ports and address for docker-compose. 127.0.0.1 keeps them on this computer.
DB_PORT=5432
APP_PORT=3000
BIND_ADDRESS=127.0.0.1

# `bun dev` and drizzle-kit connect to this local database on their own (src/lib/db/url.ts).
# Set DATABASE_URL only to use another database, e.g. a hosted Postgres. Careful: with it set,
# local development writes there too.
# DATABASE_URL=

# Hosted deployment (Vercel + Neon) sets these in the project's Environment Variables, not here:
#   DATABASE_URL                 pooled connection string, e.g. postgresql://…-pooler.…/neondb?sslmode=require
#   BETTER_AUTH_URL              the public origin people open, e.g. https://offerhive-git-<branch>-<scope>.vercel.app
#   BETTER_AUTH_SECRET           a long random string (openssl rand -base64 32)
#   BETTER_AUTH_TRUSTED_ORIGINS  extra origins allowed to sign in, comma-separated, wildcards allowed
#                                (e.g. https://*.vercel.app); BETTER_AUTH_URL is trusted anyway
#   DATABASE_POOL_MAX            connections per instance, default 2; keep it small on serverless
# Migrations go through the *direct* (non-pooled) string, once per schema change:
#   DATABASE_URL="<direct>" bun run db:migrate

# Tests: the database tests run only when this is set. Use a throwaway database — they empty its
# tables. Locally: create one (docker compose exec db createdb -U offerhive offerhive_test), apply
# the migrations to it, then run `TEST_DATABASE_URL=... bun run test`. In CI it is the CI Postgres.
# TEST_DATABASE_URL=

# Sign-in (Better Auth, email + password).
# Secret for signing sessions: any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
# Where the app is opened.
BETTER_AUTH_URL=http://localhost:3000

# Outgoing mail. Locally: Mailpit from docker-compose (docker compose up -d db mailpit).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Offerhive <no-reply@offerhive.local>
